<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post ? "Editar" : "Nuevo" %> Post — Social Media</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="/css/theme.css" rel="stylesheet">
</head>
<body>

  <nav class="brand-bar">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px; margin-bottom: 60px;">
    <div class="form-container">
      <h4 style="margin-bottom: 30px; text-align: center;">
        <%= post ? "Editar Post" : "Nuevo Post" %>
      </h4>

      <form action="<%= action %>" method="POST" class="form-panel">

        <!-- Sección 1: Autor -->
        <div class="form-section">
          <div class="form-section-header">
            <i class="material-icons">person_outline</i>
            <h5>Autor</h5>
          </div>
          <div class="input-field">
            <select name="userId" required>
              <option value="" disabled <%= !post ? "selected" : "" %>>Selecciona un autor</option>
              <% users.forEach(u => { %>
                <option value="<%= u._id %>" <%= (post && post.user && String(post.user._id) === String(u._id)) ? "selected" : "" %>>
                  <%= u.name %> <%= u.lastName %>
                </option>
              <% }) %>
            </select>
            <label>Selecciona un autor</label>
          </div>
          <a href="/users/new" class="create-user-link">+ Crear nuevo usuario</a>
        </div>

        <!-- Sección 2: Contenido -->
        <div class="form-section">
          <div class="form-section-header">
            <i class="material-icons">edit_note</i>
            <h5>Contenido del Post</h5>
          </div>

          <div class="input-field">
            <input type="text" name="title" id="title" minlength="5" maxlength="30" required
                   value="<%= post ? post.title : '' %>"
                   oninput="document.getElementById('titleCount').textContent = this.value.length">
            <label for="title">Título</label>
            <div class="char-count"><span id="titleCount"><%= post ? post.title.length : 0 %></span>/30</div>
          </div>

          <div class="input-field">
            <textarea name="content" id="content" class="materialize-textarea" minlength="10" required><%= post ? post.content : '' %></textarea>
            <label for="content">Contenido (mínimo 10 caracteres)</label>
          </div>

          <div class="input-field">
            <input type="text" name="hashtags" id="hashtags"
                   value="<%= post && post.hashtags ? post.hashtags.join(', ') : '' %>">
            <label for="hashtags">Hashtags (separados por coma)</label>
          </div>
        </div>

        <!-- Sección 3: Imagen -->
        <div class="form-section">
          <div class="form-section-header">
            <i class="material-icons">image</i>
            <h5>Imagen (Opcional)</h5>
          </div>

          <div class="input-field">
            <input type="text" name="imageUrl" id="imageUrl"
                   value="<%= post ? (post.imageUrl || '') : '' %>">
            <label for="imageUrl">URL de imagen</label>
          </div>
        </div>

        <!-- Footer con botones -->
        <div class="form-footer">
          <a href="/posts" class="btn-flat">Cancelar</a>
          <button type="submit" class="btn waves-effect waves-light">
            <%= post ? "Guardar cambios" : "Publicar" %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('select');
      var instances = M.FormSelect.init(elems);
    });
  </script>
</body>
</html>