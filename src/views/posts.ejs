<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Publicaciones — Social Media</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="/css/theme.css" rel="stylesheet">
</head>
<body>

  <nav class="brand-bar">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px; margin-bottom: 60px;">
    <div class="row" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px;">
      <div class="col s12 m6">
        <h3 style="margin: 0;">Publicaciones</h3>
        <p class="text-muted" style="margin: 5px 0 0;">Explora lo que otros comparten</p>
      </div>
      <div class="col s12 m6 right-align" style="margin-top: 10px;">
        <a href="/posts/new" class="btn waves-effect waves-light">
          <i class="material-icons left">add</i>Nuevo Post
        </a>
      </div>
    </div>

    <div class="row">
      <% if (posts.length === 0) { %>
        <div class="empty-state center-align" style="width:100%; padding:80px 0;">
          <i class="material-icons large" style="font-size: 80px;">insert_drive_file</i>
          <h5>Todavía no hay publicaciones</h5>
          <p>Crea la primera desde el botón "Nuevo Post".</p>
        </div>
      <% } %>

      <% posts.forEach(post => { %>
        <div class="col s12 m6 l4">
          <div class="card post-card">
            <% if (post.imageUrl) { %>
              <div class="card-image">
                <img src="<%= post.imageUrl %>" alt="Imagen del post" style="height: 200px; object-fit: cover;">
              </div>
            <% } %>
            <div class="card-content">
              <span class="card-title"><%= post.title %></span>
              <p><%= post.content %></p>
              <% if (post.hashtags && post.hashtags.length > 0) { %>
                <div style="margin-top: 12px;">
                  <% post.hashtags.forEach(tag => { %>
                    <span class="chip">#<%= tag %></span>
                  <% }) %>
                </div>
              <% } %>
            </div>
            <div class="card-action" style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.85rem; color: var(--text-muted);">
                <i class="material-icons tiny" style="vertical-align: middle; margin-right: 4px; color: var(--coral);">person</i>
                <%= post.user ? (post.user.name + " " + post.user.lastName) : "Desconocido" %>
              </span>
              <div style="display: flex; gap: 4px;">
                <a href="/posts/<%= post._id %>/edit" class="btn-flat tooltipped" data-tooltip="Editar" style="padding: 0 8px;">
                  <i class="material-icons action-icon edit">edit</i>
                </a>
                <form action="/posts/<%= post._id %>/delete" method="POST" style="display:inline;"
                      onsubmit="return confirm('¿Eliminar este post?');">
                  <button type="submit" class="btn-flat tooltipped" data-tooltip="Eliminar" style="background:none;border:none; padding: 0 8px;">
                    <i class="material-icons action-icon delete">delete</i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('.tooltipped');
      var instances = M.Tooltip.init(elems);
    });
  </script>
</body>
</html>